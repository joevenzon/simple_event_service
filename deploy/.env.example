SES_ENV=production
SES_DOMAIN=events.example.com
SES_BASE_URL=https://events.example.com
SES_DATA_DIR=/data
EVENT_RETENTION_DAYS=7
SESSION_SECRET=replace-with-at-least-32-random-characters
SES_LOG_LEVEL=info

# Authentication and submission limits (defaults shown):
SES_SESSION_HOURS=24
SES_LOGIN_ATTEMPTS=10
SES_LOGIN_WINDOW_SECONDS=300
SES_INGEST_PER_MINUTE=60

# Generate a random topic and subscribe in the iPhone ntfy app before enabling delivery.
# Leave NTFY_TOPIC empty to disable publishing. No events are selected until rules exist.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_SEND_IMAGES=false
SES_NOTIFICATION_COOLDOWN_SECONDS=60
SES_NOTIFICATION_MAX_ATTEMPTS=8
