SES_ENV=production
SES_DOMAIN=events.example.com
SES_BASE_URL=https://events.example.com
SES_DATA_DIR=/data
EVENT_RETENTION_DAYS=7
SESSION_SECRET=replace-with-at-least-32-random-characters
SES_LOG_LEVEL=info

# Optional Phase 1 limits (defaults shown):
SES_SESSION_HOURS=24
SES_LOGIN_ATTEMPTS=10
SES_LOGIN_WINDOW_SECONDS=300
SES_INGEST_PER_MINUTE=60

# Reserved for Phase 3; notifications are not sent yet.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=replace-with-long-random-topic
NTFY_SEND_IMAGES=false
